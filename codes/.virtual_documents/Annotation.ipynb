def gene_name_transcript(x):

    x = x['column_9'].split(";")
    # print(x)
    # exit(1)
    xx = {"gene_name":None, "transcript_id":None}
    try:
        for val in x:
            vv = val.split()
            if not vv:continue
            if vv[0] in ["gene_name","transcript_id"]:#"gene_id",
                xx[vv[0]] =  vv[1].strip('"')
    except:
        print(x)
        
    # print(xx)
    
    
    return xx #["gene_id"],xx["gene_name"],xx["transcript_id"]


