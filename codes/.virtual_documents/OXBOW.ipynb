def genomic_pos(x):
    # print(x)
    idx = np.where(np.array(x["local_range"]) < x["pos"])[0][-1]
    genomic_range = x["ranges"][idx]
    if x["strand"] == "+":
        return genomic_range[0] + x["pos"] - x["local_range"][0]
    else:
        return genomic_range[1] - ( x["pos"] - x["local_range"][0])


